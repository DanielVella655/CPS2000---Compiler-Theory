extern type Custom::Struct::Point {
  x : i32;
  y : i32;
  valid : bool;
  next : ptr<Custom::Struct::Point>;
}

function Test::move_point(%p: ptr<Custom::Struct::Point>, %dx: i32, %dy: i32) -> void {
  locals {
    %xptr : ptr<i32>;
    %yptr : ptr<i32>;
    %vptr : ptr<bool>;
    %nptr : ptr<ptr<Custom::Struct::Point>>;
    %x : i32;
    %y : i32;
    %newx : i32;
    %newy : i32;
    %ok : bool;
    %nullp : ptr<Custom::Struct::Point>;
    %is_root : bool;
    %local_copy : i32;
    %copy_ptr : ptr<i32>;
    %calc1 : i32;
    %calc2 : i32;
  }
  entry bb0;
  
  bb0:
    %nullp = const null;
    %is_root = bin ne %p, %nullp;
    %xptr = member_ptr %p, x;
    %yptr = member_ptr %p, y;
    %vptr = member_ptr %p, valid;
    %nptr = member_ptr %p, next;
    %x = load %xptr;
    %y = load %yptr;
    %calc1 = bin mul %dx, %dy;
    %newx = bin add %x, %dx;
    %newy = bin add %y, %dy;
    %calc2 = bin sub %newx, %calc1;
    store %xptr, %newx;
    store %yptr, %newy;
    %ok = const true;
    store %vptr, %ok;
    %local_copy = %newx;
    %copy_ptr = addr_of %local_copy;
    store %copy_ptr, %newy;
    cjump %is_root, bb1, bb2;
  
  bb1:
    store %nptr, %nullp;
    return;
  
  bb2:
    return;
}
